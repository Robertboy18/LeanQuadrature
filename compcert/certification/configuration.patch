+Fixpoint choose_allocation (f : RTL.function) (env : regenv)
+    (candidates : list LTL.function) : res LTL.function :=
+  match candidates with
+  | nil => Error (msg "no validated allocation candidate")
+  | tf :: rest =>
+      if signature_eq (RTL.fn_sig f) (LTL.fn_sig tf) then
+        match check_function f tf env with
+        | OK _ => OK tf
+        | Error _ => choose_allocation f env rest
+        end
+      else choose_allocation f env rest
+  end.
